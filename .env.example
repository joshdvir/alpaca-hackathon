# Copy this file to .env and fill in real values.
# .env is gitignored.

# === Postgres ===
POSTGRES_USER=trader
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trading

# === Rails api container ===
RAILS_ENV=development
DATABASE_URL=postgres://trader:changeme@postgres:5432/trading
PORT=3000

# === Temporal ===
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=trading-queue

# Temporal worker Tuner slot limits are configured per worker class
# in app/workers/<class>.rb via `tuner_settings` (a Hash with
# :workflow_slots, :activity_slots, :local_activity_slots). The base
# ApplicationWorker provides a conservative default; subclasses
# override to tune for their own resource profile. Edit the class to
# change a worker's Tuner — there is no env-var override path.
#
# The defaults throttle activity execution at 5 per task queue so the
# LLM burst stays under the upstream MiniMax / Anthropic rate limit.
# Tune activity_slots down to 2-3 if you still see
# RubyLLM::RateLimitError.

# === Alpaca (paper) ===
ALPACA_API_KEY=your_key
ALPACA_SECRET_KEY=your_secret
ALPACA_PAPER_TRADE=true
ALPACA_MCP_URL=http://alpaca-mcp:8000/mcp
FASTMCP_LOG_LEVEL=INFO

# === External data ===
FRED_API_KEY=your_key
# SEC EDGAR: no key required, but User-Agent must be set in code

# === Additional MCP data sources (see mcp/<server>/README.md) ===
# TradingView: no key required (public TradingView endpoints)
TRADINGVIEW_MCP_URL=http://tradingview-mcp:8001/mcp

# Options flow: no key required by default
OPTIONSFLOW_MCP_URL=http://optionsflow-mcp:8003/mcp
